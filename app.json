{
  "expo": {
    "name": "GameChanger",
    "slug": "sport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "GameChanger uses your photos to save physique progress pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "GameChanger reads your step count to show daily steps."
        }
      ]
    ],
    "scheme": "sport",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "5335c8ed-2d10-44d3-87f0-08c17aa17cc1"
      }
    },
    "owner": "filiocha",
    "updates": {
      "url": "https://u.expo.dev/5335c8ed-2d10-44d3-87f0-08c17aa17cc1"
    }
  }
}
